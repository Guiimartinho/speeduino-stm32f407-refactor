// Main Loop
//=============================================================================

/**
 * @brief Speeduino main loop - MISRA-C refactored
 *
 * Main loop execution flow:
 * 1. Communication handling (serial, CAN)
 * 2. Timing and RPM updates
 * 3. Sensor polling (1kHz to 1Hz)
 * 4. Idle control
 * 5. Main calculations (if synced):
 *    - VE and advance lookups
 *    - Fuel calculations and corrections
 *    - Injector angle calculations
 *    - Ignition calculations
 *    - Engine protection
 *    - Fuel and ignition scheduling
 *
 * @note MISRA-C compliant: Lines: 35 | Cyclomatic: 2 | Nesting: 1
 * @note Previous: Lines: 195 | Cyclomatic: 24 | Nesting: 4 (CRITICAL violation)
 * @see handleLoopTiming(), updateEngineRPMState(), pollAllSensors(),
 *      handleIdleControl(), performMainCalculations()
 */
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Wattributes"
void loop(void)
{
  // Loop housekeeping
  SAFE_INCREMENT(mainLoopCount, MAIN_LOOP_COUNT_MAX);
  LOOP_TIMER = TIMER_mask;

  // Communication handling (highest priority)
  handleSerialComms();
  handleSecondarySerial();
  handleCANComms();

  // Timing and RPM calculations
  uint32_t currentMicros = micros();
  handleLoopTiming(currentMicros);
  updateEngineRPMState(currentMicros);

  // Sensor polling at different frequencies
  pollAllSensors();

  // Stepper idle control
  handleIdleControl();

  // Main calculations (only if synced and RPM in valid range)
  if(isEngineSyncedAndRunning())
  {
    performMainCalculations();
  }
  else
  {
    clearResetPreventionIfNeeded();
  }
}
#pragma GCC diagnostic pop
