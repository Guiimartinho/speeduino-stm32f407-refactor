// Main Loop Helpers (MISRA-C Refactored)
//=============================================================================

/**
 * @brief Handle loop timing and micros() overflow
 * @param currentMicros Current microseconds timestamp
 * @note MISRA-C compliant: Lines: 7 | Cyclomatic: 2 | Nesting: 1
 */
static inline void handleLoopTiming(uint32_t currentMicros)
{
  // Handle micros() overflow - clear deferred EEPROM writes
  if(currentLoopTime > currentMicros)
  {
    deferEEPROMWritesUntil = 0;
  }
  currentLoopTime = currentMicros;
}

/**
 * @brief Update RPM for running engine with validation
 * @note MISRA-C compliant: Lines: 15 | Cyclomatic: 3 | Nesting: 2
 */
static inline void updateRunningEngineRPM(void)
{
  // Update RPM with validation
  currentStatus.longRPM = getRPM();
  currentStatus.RPM = currentStatus.longRPM;
  currentStatus.RPMdiv100 = div100(currentStatus.RPM);

  // Validate RPM is in safe range
  if(currentStatus.RPM > MAX_SAFE_RPM)
  {
    currentStatus.RPM = MAX_SAFE_RPM;
  }

  // Turn on fuel pump if engine running
  if(currentStatus.RPM > 0)
  {
    FUEL_PUMP_ON();
    currentStatus.fuelPumpOn = true;
  }
}

/**
 * @brief Update engine RPM state based on running status
 * @param currentLoopTime Current loop time in microseconds
 * @note MISRA-C compliant: Lines: 9 | Cyclomatic: 2 | Nesting: 1
 */
static inline void updateEngineRPMState(uint32_t currentLoopTime)
{
  if(engineIsRunning(currentLoopTime))
  {
    updateRunningEngineRPM();
  }
  else
  {
    handleEngineStop();
  }
}

/**
 * @brief Poll all sensors at their configured frequencies
 * @note MISRA-C compliant: Lines: 9 | Cyclomatic: 8 | Nesting: 1
 */
static inline void pollAllSensors(void)
{
  if(BIT_CHECK(LOOP_TIMER, BIT_TIMER_1KHZ))  { pollSensors1KHz(); }
  if(BIT_CHECK(LOOP_TIMER, BIT_TIMER_200HZ)) { pollSensors200Hz(); }
  if(BIT_CHECK(LOOP_TIMER, BIT_TIMER_50HZ))  { pollSensors50Hz(); }
  if(BIT_CHECK(LOOP_TIMER, BIT_TIMER_30HZ))  { pollSensors30Hz(); }
  if(BIT_CHECK(LOOP_TIMER, BIT_TIMER_15HZ))  { pollSensors15Hz(); }
  if(BIT_CHECK(LOOP_TIMER, BIT_TIMER_10HZ))  { pollSensors10Hz(); }
  if(BIT_CHECK(LOOP_TIMER, BIT_TIMER_4HZ))   { pollSensors4Hz(); }
  if(BIT_CHECK(LOOP_TIMER, BIT_TIMER_1HZ))   { pollSensors1Hz(); }
}

/**
 * @brief Handle stepper idle control if enabled
 * @note MISRA-C compliant: Lines: 9 | Cyclomatic: 3 | Nesting: 1
 */
static inline void handleIdleControl(void)
{
  if((configPage6.iacAlgorithm == IAC_ALGORITHM_STEP_OL) ||
     (configPage6.iacAlgorithm == IAC_ALGORITHM_STEP_CL) ||
     (configPage6.iacAlgorithm == IAC_ALGORITHM_STEP_OLCL))
  {
    idleControl();
  }
}

/**
 * @brief Calculate VE and advance from lookup tables
 * @note MISRA-C compliant: Lines: 7 | Cyclomatic: 1 | Nesting: 0
 */
static inline void updateVEAndAdvance(void)
{
  currentStatus.VE1 = getVE1();
  currentStatus.VE = currentStatus.VE1;
  currentStatus.advance1 = getAdvance1();
  currentStatus.advance = currentStatus.advance1;
}

/**
 * @brief Calculate fuel parameters (corrections, PW, staging)
 * @return PW limit for scheduling
 * @note MISRA-C compliant: Lines: 10 | Cyclomatic: 1 | Nesting: 0
 */
static inline uint16_t calculateFuelParameters(void)
{
  // AFR target and corrections
  currentStatus.corrections = correctionsFuel();

  // Fuel pulsewidth calculation
  currentStatus.PW1 = PW(req_fuel_uS, currentStatus.VE, currentStatus.MAP,
                         currentStatus.corrections, inj_opentime_uS);

  // PW limit and staging
  uint16_t pwLimit = calculatePWLimit();
  calculateStaging(pwLimit);

  return pwLimit;
}

/**
 * @brief Calculate injector start angles for 2-cylinder engine
 * @param PWdivTimerPerDegree PW converted to degrees
 * @note MISRA-C compliant: Lines: 5 | Cyclomatic: 1 | Nesting: 0
 */
static inline void calculate2CylinderInjectorAngles(uint16_t PWdivTimerPerDegree)
{
  injector2StartAngle = calculateInjectorStartAngle(PWdivTimerPerDegree,
                                                     channel2InjDegrees,
                                                     currentStatus.injAngle);
}

/**
 * @brief Calculate injector start angles for 4-cylinder engine
 * @param PWdivTimerPerDegree PW converted to degrees
 * @note MISRA-C compliant: Lines: 12 | Cyclomatic: 2 | Nesting: 1
 */
static inline void calculate4CylinderInjectorAngles(uint16_t PWdivTimerPerDegree)
{
  injector2StartAngle = calculateInjectorStartAngle(PWdivTimerPerDegree,
                                                     channel2InjDegrees,
                                                     currentStatus.injAngle);

  // Sequential injection requires sync
  if((configPage2.injLayout == INJ_SEQUENTIAL) && currentStatus.hasSync)
  {
    injector3StartAngle = calculateInjectorStartAngle(PWdivTimerPerDegree,
                                                       channel3InjDegrees,
                                                       currentStatus.injAngle);
    injector4StartAngle = calculateInjectorStartAngle(PWdivTimerPerDegree,
                                                       channel4InjDegrees,
                                                       currentStatus.injAngle);
  }
}

/**
 * @brief Calculate injector start angles for 8-cylinder engine
 * @param PWdivTimerPerDegree PW converted to degrees
 * @note MISRA-C compliant: Lines: 21 | Cyclomatic: 2 | Nesting: 2
 */
static inline void calculate8CylinderInjectorAngles(uint16_t PWdivTimerPerDegree)
{
  // Base channels (always calculated)
  injector2StartAngle = calculateInjectorStartAngle(PWdivTimerPerDegree,
                                                     channel2InjDegrees,
                                                     currentStatus.injAngle);
  injector3StartAngle = calculateInjectorStartAngle(PWdivTimerPerDegree,
                                                     channel3InjDegrees,
                                                     currentStatus.injAngle);
  injector4StartAngle = calculateInjectorStartAngle(PWdivTimerPerDegree,
                                                     channel4InjDegrees,
                                                     currentStatus.injAngle);

  // Channels 5-8 only for sequential with sync
  #if INJ_CHANNELS >= 8
  if((configPage2.injLayout == INJ_SEQUENTIAL) && currentStatus.hasSync)
  {
    injector5StartAngle = calculateInjectorStartAngle(PWdivTimerPerDegree, channel5InjDegrees, currentStatus.injAngle);
    injector6StartAngle = calculateInjectorStartAngle(PWdivTimerPerDegree, channel6InjDegrees, currentStatus.injAngle);
    injector7StartAngle = calculateInjectorStartAngle(PWdivTimerPerDegree, channel7InjDegrees, currentStatus.injAngle);
    injector8StartAngle = calculateInjectorStartAngle(PWdivTimerPerDegree, channel8InjDegrees, currentStatus.injAngle);
  }
  #endif
}

/**
 * @brief Calculate all injector start angles based on cylinder count
 * @param PWdivTimerPerDegree PW converted to degrees
 * @note MISRA-C compliant: Lines: 20 | Cyclomatic: 4 | Nesting: 1
 */
static inline void calculateAllInjectorStartAngles(uint16_t PWdivTimerPerDegree)
{
  // Injector 1 always calculated
  injector1StartAngle = calculateInjectorStartAngle(PWdivTimerPerDegree,
                                                     channel1InjDegrees,
                                                     currentStatus.injAngle);

  // Calculate additional injector angles based on cylinder count
  switch(configPage2.nCylinders)
  {
    case 2:
      calculate2CylinderInjectorAngles(PWdivTimerPerDegree);
      break;
    case 4:
      calculate4CylinderInjectorAngles(PWdivTimerPerDegree);
      break;
    case 8:
      calculate8CylinderInjectorAngles(PWdivTimerPerDegree);
      break;
    default:
      break;
  }
}

/**
 * @brief Calculate ignition parameters (dwell, angles, per-tooth)
 * @note MISRA-C compliant: Lines: 10 | Cyclomatic: 2 | Nesting: 1
 */
static inline void calculateIgnitionParameters(void)
{
  currentStatus.dwell = calculateDwell();
  calculateIgnitionAngles(timeToAngleDegPerMicroSec(currentStatus.dwell));

  // Per-tooth ignition timing (if enabled)
  if(configPage2.perToothIgn == true)
  {
    triggerSetEndTeeth();
  }
}

/**
 * @brief Apply engine protection and schedule outputs
 * @param pwLimit PW limit for fuel scheduling
 * @note MISRA-C compliant: Lines: 16 | Cyclomatic: 3 | Nesting: 1
 */
static inline void applyProtectionAndSchedule(uint16_t pwLimit)
{
  // Engine protection (rev limiter, launch, flat shift)
  uint16_t maxAllowedRPM = calculateMaxAllowedRPM();
  applyEngineProtection(maxAllowedRPM);

  // Fuel scheduling
  if(fuelChannelsOn > 0)
  {
    scheduleFuelInjection(pwLimit);
  }

  // Ignition scheduling
  if(ignitionChannelsOn > 0)
  {
    scheduleIgnition();
  }
}

/**
 * @brief Handle reset prevention control
 * @note MISRA-C compliant: Lines: 10 | Cyclomatic: 2 | Nesting: 1
 */
static inline void handleResetPrevention(void)
{
  if((!BIT_CHECK(currentStatus.status3, BIT_STATUS3_RESET_PREVENT)) &&
     (resetControl == RESET_CONTROL_PREVENT_WHEN_RUNNING))
  {
    digitalWrite(pinResetControl, HIGH);
    BIT_SET(currentStatus.status3, BIT_STATUS3_RESET_PREVENT);
  }
}

/**
 * @brief Clear reset prevention when engine not synced
 * @note MISRA-C compliant: Lines: 10 | Cyclomatic: 2 | Nesting: 1
 */
static inline void clearResetPreventionIfNeeded(void)
{
  if((BIT_CHECK(currentStatus.status3, BIT_STATUS3_RESET_PREVENT) > 0) &&
     (resetControl == RESET_CONTROL_PREVENT_WHEN_RUNNING))
  {
    digitalWrite(pinResetControl, LOW);
    BIT_CLEAR(currentStatus.status3, BIT_STATUS3_RESET_PREVENT);
  }
}

/**
 * @brief Check if engine is synced and running in valid RPM range
 * @return true if synced and RPM valid, false otherwise
 * @note MISRA-C compliant: Lines: 6 | Cyclomatic: 2 | Nesting: 0
 */
static inline bool isEngineSyncedAndRunning(void)
{
  return (((currentStatus.hasSync == true) ||
           BIT_CHECK(currentStatus.status3, BIT_STATUS3_HALFSYNC)) &&
          IS_IN_RANGE(currentStatus.RPM, MIN_RUNNING_RPM, MAX_SAFE_RPM));
}

/**
 * @brief Perform all main calculations (fuel, ignition, scheduling)
 * @note MISRA-C compliant: Lines: 13 | Cyclomatic: 1 | Nesting: 0
 */
static inline void performMainCalculations(void)
{
  // VE and Advance lookups
  updateVEAndAdvance();

  // Fuel calculations
  uint16_t pwLimit = calculateFuelParameters();

  // Injector angle calculations
  calculateAllInjectorStartAngles(timeToAngleDegPerMicroSec(currentStatus.PW1));

  // Ignition calculations
  calculateIgnitionParameters();

  // Engine protection and scheduling
  applyProtectionAndSchedule(pwLimit);

  // Reset prevention
  handleResetPrevention();
}

