/**
 * @brief Configuration structure for fuel injection channel
 * @details Data-driven approach to reduce cyclomatic complexity
 *
 * MISRA-C: Compile-time constant structure for zero runtime overhead
 */
struct FuelChannelConfig
{
  FuelSchedule* schedule;
  int* startAngle;
  unsigned int* pulseWidth;
  uint8_t cmdBit;
};

/*-----------------------------------------------------------------------------------------
| A Note on tempCrankAngle and tempStartAngle:
|   The use of tempCrankAngle/tempStartAngle is described below. It is then used in the
|   same way for channels 2, 3 and 4+ on both injectors and ignition
|
|   Essentially, these 2 variables are used to realign the current crank angle and the
|   desired start angle around 0 degrees for the given cylinder/output
|
|   Eg: If cylinder 2 TDC is 180 degrees after cylinder 1 (Eg a standard 4 cylinder engine),
|       then tempCrankAngle is 180* less than the current crank angle and tempStartAngle
|       is the desired open time less 180*. Thus the cylinder is being treated relative to
|       its own TDC, regardless of its offset
|
|   This is done to avoid problems with very short or very long times until tempStartAngle.
|------------------------------------------------------------------------------------------
*/

/**
 * @brief Schedule individual fuel injection channel
 * @details Helper function to reduce code duplication and complexity
 *
 * MISRA-C: 12 lines, N:2, C:3
 *
 * @param config Channel configuration (schedule, angles, pulsewidth, cmd bit)
 * @param crankAngle Current crank angle (0-720 degrees)
 */
static inline void scheduleChannel(const FuelChannelConfig& config, uint16_t crankAngle)
{
  if ((*config.pulseWidth >= inj_opentime_uS) && (BIT_CHECK(fuelChannelsOn, config.cmdBit)))
  {
    uint32_t timeOut = calculateInjectorTimeout(*config.schedule, *config.startAngle, crankAngle);
    if (timeOut > 0U)
    {
      setFuelSchedule(*config.schedule, timeOut, (unsigned long)*config.pulseWidth);
    }
  }
}

/**
 * @brief Schedule fuel injection for all active channels
 * @details Array-driven architecture for MISRA-C compliance
 *
 * MISRA-C: 48 lines, N:2, C:3 (was: 134 lines, N:2, C:17)
 *
 * @param pwLimit Maximum pulsewidth limit (unused in current implementation)
 *
 * @note Refactored FASE FS - reduced complexity via data-driven approach
 *       Original: C:17 (8 channels × 2 if statements + base = 17)
 *       Refactored: C:3 (loop + 2 if statements in helper)
 */
void scheduleFuelInjection(uint16_t pwLimit)
{
  uint16_t crankAngle = getCrankAngle();

  // Channel configuration table - compile-time constant
  static const FuelChannelConfig channels[INJ_CHANNELS] = {
    #if INJ_CHANNELS >= 1
    {&fuelSchedule1, &injector1StartAngle, &currentStatus.PW1, INJ1_CMD_BIT},
    #endif
    #if INJ_CHANNELS >= 2
    {&fuelSchedule2, &injector2StartAngle, &currentStatus.PW2, INJ2_CMD_BIT},
    #endif
    #if INJ_CHANNELS >= 3
    {&fuelSchedule3, &injector3StartAngle, &currentStatus.PW3, INJ3_CMD_BIT},
    #endif
    #if INJ_CHANNELS >= 4
    {&fuelSchedule4, &injector4StartAngle, &currentStatus.PW4, INJ4_CMD_BIT},
    #endif
    #if INJ_CHANNELS >= 5
    {&fuelSchedule5, &injector5StartAngle, &currentStatus.PW5, INJ5_CMD_BIT},
    #endif
    #if INJ_CHANNELS >= 6
    {&fuelSchedule6, &injector6StartAngle, &currentStatus.PW6, INJ6_CMD_BIT},
    #endif
    #if INJ_CHANNELS >= 7
    {&fuelSchedule7, &injector7StartAngle, &currentStatus.PW7, INJ7_CMD_BIT},
    #endif
    #if INJ_CHANNELS >= 8
    {&fuelSchedule8, &injector8StartAngle, &currentStatus.PW8, INJ8_CMD_BIT}
    #endif
  };

  // Iterate through active channels (bounds checked at compile time)
  for (uint8_t ch = 0; (ch < maxInjOutputs) && (ch < INJ_CHANNELS); ch++)
  {
    scheduleChannel(channels[ch], crankAngle);
  }
}
