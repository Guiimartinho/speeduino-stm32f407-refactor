/**
 * @brief Configuration structure for ignition channel
 * @details Data-driven approach to reduce cyclomatic complexity
 *
 * MISRA-C: Compile-time constant structure for zero runtime overhead
 */
struct IgnitionChannelConfig
{
  IgnitionSchedule* schedule;
  int* startAngle;
  int* ignDegrees;
  uint8_t cmdBit;
};

/**
 * @brief Adjust ignition start angles for low RPM cranking
 * @details Moves start time forward to prevent timing after tooth pulse
 *
 * MISRA-C: 20 lines, N:1, C:1
 */
static inline void adjustIgnitionStartAnglesForCranking(void)
{
  static int* const startAngles[IGN_CHANNELS] = {
    &ignition1StartAngle,
    &ignition2StartAngle,
    &ignition3StartAngle,
    &ignition4StartAngle,
    #if IGN_CHANNELS >= 5
    &ignition5StartAngle,
    #endif
    #if IGN_CHANNELS >= 6
    &ignition6StartAngle,
    #endif
    #if IGN_CHANNELS >= 7
    &ignition7StartAngle,
    #endif
    #if IGN_CHANNELS >= 8
    &ignition8StartAngle
    #endif
  };

  for (uint8_t ch = 0; ch < IGN_CHANNELS; ch++)
  {
    *startAngles[ch] -= 5;
  }
}

/**
 * @brief Calculate fixed cranking override for dwell extension
 * @details Extends dwell 3x during cranking for decoder-triggered spark
 *
 * MISRA-C: 14 lines, N:2, C:4
 *
 * @return Dwell extension in microseconds, or 0 if not in fixed cranking mode
 */
static inline uint32_t calculateFixedCrankingOverride(void)
{
  if (!configPage4.ignCranklock) { return 0; }
  if (!BIT_CHECK(currentStatus.engine, BIT_ENGINE_CRANK)) { return 0; }
  if (!BIT_CHECK(decoderState, BIT_DECODER_HAS_FIXED_CRANKING)) { return 0; }

  if (currentStatus.RPM < 250)
  {
    adjustIgnitionStartAnglesForCranking();
  }

  return currentStatus.dwell * 3;
}

/**
 * @brief Schedule individual ignition channel
 * @details Helper function to reduce code duplication and complexity
 *
 * MISRA-C: 12 lines, N:2, C:3
 *
 * @param config Channel configuration (schedule, angles, ignition degrees, cmd bit)
 * @param crankAngle Current crank angle (0-720 degrees)
 * @param dwellOverride Additional dwell time for cranking mode
 */
static inline void scheduleIgnitionChannel(const IgnitionChannelConfig& config,
                                          uint16_t crankAngle,
                                          uint32_t dwellOverride)
{
  uint32_t timeOut = calculateIgnitionTimeout(*config.schedule, *config.startAngle,
                                              *config.ignDegrees, crankAngle);

  if ((timeOut > 0U) && (BIT_CHECK(ignitionChannelsOn, config.cmdBit)))
  {
    setIgnitionSchedule(*config.schedule, timeOut, currentStatus.dwell + dwellOverride);
  }
}

/**
 * @brief Refresh ignition timing for channel 1 during acceleration/deceleration
 * @details Dynamic timing correction for channel 1 only (wasted spark pair)
 *
 * MISRA-C: 23 lines, N:2, C:5
 *
 * @param crankAngle Current crank angle
 * @param dwellOverride Additional dwell for cranking mode
 *
 * @note Only enabled with USE_IGN_REFRESH compile flag
 */
#if defined(USE_IGN_REFRESH)
static inline void refreshIgnitionChannel1IfNeeded(uint16_t crankAngle, uint32_t dwellOverride)
{
  if (ignitionSchedule1.Status != RUNNING) { return; }
  if (ignition1EndAngle <= crankAngle) { return; }
  if (configPage4.StgCycles != 0) { return; }
  if (configPage2.perToothIgn == true) { return; }

  crankAngle = ignitionLimits(getCrankAngle());

  unsigned long uSToEnd = 0;
  if (ignition1EndAngle > crankAngle)
  {
    uSToEnd = angleToTimeMicroSecPerDegree(ignition1EndAngle - crankAngle);
  }
  else
  {
    uSToEnd = angleToTimeMicroSecPerDegree(360 + ignition1EndAngle - crankAngle);
  }

  refreshIgnitionSchedule1(uSToEnd + dwellOverride);
}
#endif

/**
 * @brief Schedule ignition for all active channels
 * @details Array-driven architecture for MISRA-C compliance
 *
 * MISRA-C: 63 lines, N:2, C:5 (was: 188 lines, N:4, C:41)
 *
 * @note Refactored FASE IS - reduced complexity via data-driven approach
 *       Original: C:41 (8 channels × multiple conditions + cranking + refresh)
 *       Refactored: C:5 (cranking check + loop + refresh conditions)
 */
void scheduleIgnition(void)
{
  uint32_t fixedCrankingOverride = calculateFixedCrankingOverride();

  if (ignitionChannelsOn == 0) { return; }

  uint16_t crankAngle = ignitionLimits(getCrankAngle());

  // Channel configuration table - compile-time constant
  static const IgnitionChannelConfig channels[IGN_CHANNELS] = {
    #if IGN_CHANNELS >= 1
    {&ignitionSchedule1, &ignition1StartAngle, &channel1IgnDegrees, IGN1_CMD_BIT},
    #endif
    #if IGN_CHANNELS >= 2
    {&ignitionSchedule2, &ignition2StartAngle, &channel2IgnDegrees, IGN2_CMD_BIT},
    #endif
    #if IGN_CHANNELS >= 3
    {&ignitionSchedule3, &ignition3StartAngle, &channel3IgnDegrees, IGN3_CMD_BIT},
    #endif
    #if IGN_CHANNELS >= 4
    {&ignitionSchedule4, &ignition4StartAngle, &channel4IgnDegrees, IGN4_CMD_BIT},
    #endif
    #if IGN_CHANNELS >= 5
    {&ignitionSchedule5, &ignition5StartAngle, &channel5IgnDegrees, IGN5_CMD_BIT},
    #endif
    #if IGN_CHANNELS >= 6
    {&ignitionSchedule6, &ignition6StartAngle, &channel6IgnDegrees, IGN6_CMD_BIT},
    #endif
    #if IGN_CHANNELS >= 7
    {&ignitionSchedule7, &ignition7StartAngle, &channel7IgnDegrees, IGN7_CMD_BIT},
    #endif
    #if IGN_CHANNELS >= 8
    {&ignitionSchedule8, &ignition8StartAngle, &channel8IgnDegrees, IGN8_CMD_BIT}
    #endif
  };

  // Iterate through active channels (bounds checked at compile time)
  for (uint8_t ch = 0; (ch < maxIgnOutputs) && (ch < IGN_CHANNELS); ch++)
  {
    scheduleIgnitionChannel(channels[ch], crankAngle, fixedCrankingOverride);
  }

  // Refresh timing for channel 1 during acceleration/deceleration (wasted spark pair)
  #if defined(USE_IGN_REFRESH)
  refreshIgnitionChannel1IfNeeded(crankAngle, fixedCrankingOverride);
  #endif
}
